{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "http_message",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank"
        },
        {
          "type": "SYMBOL",
          "name": "request"
        },
        {
          "type": "SYMBOL",
          "name": "response"
        }
      ]
    },
    "request": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_bodiless_request"
        },
        {
          "type": "SYMBOL",
          "name": "_body_request"
        }
      ]
    },
    "_bodiless_request": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "method",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_bodiless_method"
              },
              "named": true,
              "value": "method"
            }
          },
          {
            "type": "SYMBOL",
            "name": "_ws"
          },
          {
            "type": "SYMBOL",
            "name": "_request_line"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "header"
                },
                {
                  "type": "SYMBOL",
                  "name": "plain"
                }
              ]
            }
          }
        ]
      }
    },
    "_body_request": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "method",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_body_method"
              },
              "named": true,
              "value": "method"
            }
          },
          {
            "type": "SYMBOL",
            "name": "_ws"
          },
          {
            "type": "SYMBOL",
            "name": "_request_line"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "header"
                },
                {
                  "type": "SYMBOL",
                  "name": "plain"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "REPEAT1",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_blank"
                    }
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "FIELD",
                        "name": "body",
                        "content": {
                          "type": "SYMBOL",
                          "name": "body"
                        }
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_bodiless_method": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[Gg][Ee][Tt]"
          },
          {
            "type": "PATTERN",
            "value": "[Hh][Ee][Aa][Dd]"
          },
          {
            "type": "PATTERN",
            "value": "[Oo][Pp][Tt][Ii][Oo][Nn][Ss]"
          },
          {
            "type": "PATTERN",
            "value": "[Dd][Ee][Ll][Ee][Tt][Ee]"
          },
          {
            "type": "PATTERN",
            "value": "[Tt][Rr][Aa][Cc][Ee]"
          },
          {
            "type": "PATTERN",
            "value": "[Cc][Oo][Nn][Nn][Ee][Cc][Tt]"
          }
        ]
      }
    },
    "_body_method": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[Pp][Oo][Ss][Tt]"
          },
          {
            "type": "PATTERN",
            "value": "[Pp][Uu][Tt]"
          },
          {
            "type": "PATTERN",
            "value": "[Pp][Aa][Tt][Cc][Hh]"
          }
        ]
      }
    },
    "_request_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "target"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_ws"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "version",
                      "content": {
                        "type": "SYMBOL",
                        "name": "version"
                      }
                    },
                    {
                      "type": "SYMBOL",
                      "name": "trailer"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_ws"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "target": {
      "type": "SYMBOL",
      "name": "url_text"
    },
    "url_text": {
      "type": "PATTERN",
      "value": "[^\\s]+"
    },
    "version": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 7,
        "content": {
          "type": "PATTERN",
          "value": "HTTP\\/[0-9.]+"
        }
      }
    },
    "trailer": {
      "type": "PATTERN",
      "value": "[^\\s][^\\r\\n]*"
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "header_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_ws"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_ws"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "SYMBOL",
                "name": "value"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "header_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s:][^:\\r\\n]*"
        }
      }
    },
    "plain": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "([^\\s:][^:\\r\\n]*|[ \\t]+[^\\s][^\\r\\n]*)(\\r?\\n|\\r)"
        }
      }
    },
    "response": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "version",
            "content": {
              "type": "SYMBOL",
              "name": "version"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_status_line_tail"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_eol"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "header"
                },
                {
                  "type": "SYMBOL",
                  "name": "plain"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "REPEAT1",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_blank"
                    }
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "FIELD",
                        "name": "body",
                        "content": {
                          "type": "SYMBOL",
                          "name": "body"
                        }
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_status_line_tail": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "status",
              "content": {
                "type": "SYMBOL",
                "name": "status_code"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_ws"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "FIELD",
                  "name": "reason",
                  "content": {
                    "type": "SYMBOL",
                    "name": "status_text"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "status_code": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[0-9]+"
        }
      }
    },
    "status_text": {
      "type": "PATTERN",
      "value": "[^\\s][^\\r\\n]*"
    },
    "body": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_body_head"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_terminal_line"
          }
        }
      ]
    },
    "_body_head": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 8,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*[^\\s][^\\r\\n]*(\\r?\\n|\\r)?"
        }
      }
    },
    "_terminal_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 8,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]*(\\r?\\n|\\r)|[^\\r\\n]+"
        }
      }
    },
    "value": {
      "type": "SYMBOL",
      "name": "value_text"
    },
    "value_text": {
      "type": "PATTERN",
      "value": "[^\\r\\n]+"
    },
    "_ws": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]+"
        }
      }
    },
    "_blank": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*(\\r?\\n|\\r)"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_eol"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}