{
  "grammars": [
    {
      "name": "http",
      "camelcase": "Http",
      "title": "HTTP file",
      "scope": "source.http",
      "path": "http",
      "file-types": ["http", "rest"],
      "injection-regex": "^http$",
      "highlights": "queries/http/highlights.scm",
      "injections": "queries/http/injections.scm",
      "external-files": ["common/scanner.h"]
    },
    {
      "name": "http_message",
      "camelcase": "HttpMessage",
      "title": "HTTP message",
      "scope": "source.http-message",
      "path": "http_message",
      "injection-regex": "^(http_message|message/http)$",
      "highlights": "queries/http_message/highlights.scm",
      "injections": "queries/http_message/injections.scm",
      "external-files": ["common/scanner.h"]
    },
    {
      "name": "form_urlencoded",
      "camelcase": "FormUrlencoded",
      "title": "Form-encoded body",
      "scope": "source.form-urlencoded",
      "path": "form_urlencoded",
      "injection-regex": "^(form_urlencoded|application/x-www-form-urlencoded)$",
      "highlights": "queries/form_urlencoded/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "description": "tree-sitter grammars for .http files and message/http wire messages, and for the form-encoded bodies they carry",
    "authors": [{ "name": "X-AMZ LLC", "email": "support@x-amz.dev" }]
  },
  "bindings": { "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": true }
}
